#!name=微博：去广告
#!desc=去掉微博的广告，以及内容里的推广、推荐和提示。每一项都能单独开关：在模块参数里改，或者在微博“我”页面的“模块设置”里改。
#!category=微博
#!author=leetingo
#!homepage=https://github.com/leetingo/surge-rules
#!version=5.3.0
#!arguments=splash:true,feed_ad:true,video_ad:true,video_autoplay:false,profile_ad:true,profile_follow_rec:true,follow_rec:titled,notify_nag:true,discover_banner:true,hot_search_ad:true,chaohua_ad:true,detail_ad:true,detail_hot_search:true,detail_reward:true,detail_share_tip:true,detail_positive:true,comment_ad:true,comment_tip:true,comment_ai:true,message_ad:true,message_rec:true,popup_float:true,redpacket:true,launch_guide:true,checkin:true,push_daily:true,hot_spotlight:true,biz_domain:REJECT,huodong_domain:REJECT,entry:true
#!arguments-desc=开关类填 true 或 false。在微博里“我”页面的“模块设置”中改过的项目，优先于这里的值。\n\nsplash: [开屏] 开屏广告\n清空新版和旧版预加载的开屏广告，并拦下开屏广告的实时请求。\n\nfeed_ad: [信息流] 信息流广告\n首页、热门、分组、搜索、超话、转发列表和通用卡片流里的广告微博与广告卡片。\n\nvideo_ad: [视频流] 视频流广告和推广\n全屏视频流、小视频列表、视频混排流和预加载里的广告，以及视频带货、底部横幅和悬浮窗。\n\nvideo_autoplay: [视频流] 关闭小视频自动连播\n清空竖屏小视频列表里的后续推荐视频，播完当前视频后不再自动连播。\n\nprofile_ad: [个人主页] 他人个人主页广告\n个人主页时间线和微博分页里带广告标记的微博与卡片。保留正常微博、置顶内容和普通推荐。\n\nprofile_follow_rec: [个人主页] 关注操作和主页底栏推荐\n关注或取消关注时的相关推荐卡片，以及个人主页底部菜单里的推荐、催更、赞赏和弹窗。\n\nfollow_rec: [信息流] 关注流里的推荐微博\n    ├ titled: 只去掉带推荐标题的\n    ├ all: 未关注的一律去掉\n    └ off: 不处理\n带推荐标题指“关注 X 的人也关注”这一类。选“未关注的一律去掉”时，你关注的超话里的帖子和你自己的微博也可能被去掉。\n\nnotify_nag: [信息流] “开启通知”横幅\n信息流和热搜页里提示打开推送通知的横幅。\n\ndiscover_banner: [发现页] 顶部轮播窗\n发现页和趋势页顶部的推广轮播图与头图。\n\nhot_search_ad: [发现页] 热搜里的推广条目\n热搜列表和热搜页里带推广标记的条目。\n\nchaohua_ad: [超话] 超话推荐和热搜推广\n超话搜索页里的感兴趣话题推广，以及超话时间线里的推荐超话、热门超话和广告卡片。\n\ndetail_ad: [微博详情] 广告卡片\n新版和旧版正文下方的广告卡片、横版广告及好物种草推广。\n\ndetail_hot_search: [微博详情] “大家都在搜”卡片\n正文下方的相关搜索卡片。\n\ndetail_reward: [微博详情] 赞赏信息\n正文下方的赞赏按钮和赞赏说明。\n\ndetail_share_tip: [微博详情] 分享里的红包提示\n只去掉红包提示，分享本身不受影响。\n\ndetail_positive: [微博详情] 互动后的推荐内容\n点赞或评论之后插入的推荐内容。\n\ncomment_ad: [评论区] 评论区广告\n新版和旧版评论区及楼中楼里插在评论之间的广告微博和推广。\n\ncomment_tip: [评论区] 顶部提示条\n评论区顶部带“查看详情”的提示条和过滤提示。\n\ncomment_ai: [评论区] AI 总结和调查卡片\n“罗伯特总结”和“你对此评论区是否满意”这类调查卡片。\n\nmessage_ad: [消息页] 动态里的广告卡片\n消息页动态里带广告标记的卡片。\n\nmessage_rec: [消息页] 推荐关注\n消息页动态里的“推荐关注”，你关注的人的动态提醒会保留。\n\npopup_float: [弹窗和引导] 悬浮窗\n各页面的悬浮窗，包括强制展示的。\n\nredpacket: [弹窗和引导] 信息流红包图标\n信息流里的红包图标。\n\nlaunch_guide: [弹窗和引导] 启动引导和横幅\n发博引导、登录引导、个人页动画、红包和图片横幅的配置。\n\ncheckin: [弹窗和引导] 签到弹窗\n打开微博时的签到弹窗。\n\npush_daily: [弹窗和引导] 通知开关引导\n拦下引导打开通知、评分等提示所用的配置请求。\n\nhot_spotlight: [弹窗和引导] 热门微博聚光\n拦下“热门微博聚光”的请求。\n\nbiz_domain: [域名] 广告平台域名 biz.weibo.com\n    ├ REJECT: 拦截\n    └ DIRECT: 不拦截\n广告图片，以及广告的曝光和点击上报。只能在这里改。\n\nhuodong_domain: [域名] 活动域名 huodong.weibo.cn\n    ├ REJECT: 拦截\n    └ DIRECT: 不拦截\n活动页面。只能在这里改。\n\nentry: [入口] “我”页面里的“模块设置”入口\n填 false 不显示。只能在这里改。

[Rule]
# 广告平台的域名：广告图片，以及广告的曝光和点击上报
DOMAIN-SUFFIX,biz.weibo.com,{{{biz_domain}}}
# 活动页面的域名
DOMAIN,huodong.weibo.cn,{{{huodong_domain}}}

[Body Rewrite]
# 在“我”页面的快捷入口里加一个“模块设置”，点开是微博里的管理页面。参数 entry 填 false 可以去掉
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/profile\/me 'if ("{{{entry}}}" | ascii_downcase | test("^(false|0|off|no|关|关闭|否)$")) then . elif type == "object" and (.items | type) == "array" then .items |= map( if type == "object" and ((.itemId // "") | tostring | endswith("_-_top8")) and (.items | type) == "array" and (any(.items[]; type == "object" and .itemId == "100505_-_modulesettings") | not) then (.items | map(select(type == "object" and .type == "iconInfo" and (.content | type) == "object" and (.image | type) == "object"))) as $cells | if ($cells | length) == 0 then . else .items += [ (($cells | map(select((.itemId // "") | tostring | endswith("_-_draft"))) | .[0]) // $cells[-1]) | del(.dot) | .itemId = "100505_-_modulesettings" | .content.content = "模块设置" | .image.iconUrl = "https://raw.githubusercontent.com/leetingo/surge-rules/main/assets/weibo-settings.png" | (if (.image.style | type) == "object" then del(.image.style.darkMode) else . end) | .click = {executeType: "depend", type: "group", modules: [{type: "scheme", scheme: "https://api.weibo.cn/surge-rules/weibo/settings"}]} ] end else . end) else . end'

[Script]
# 改写响应：开屏、信息流、视频流、个人主页、超话、发现页、详情页、评论区、消息页、启动配置、签到
weibo.ad.response = type=http-response, pattern=^(?:https:\/\/bootpreload\.uve\.weibo\.com\/v[12]\/ad\/preload|https:\/\/wbapp\.uve\.weibo\.com\/(?:preload\/get_ad|wbapplua\/wbpullad\.lua)|https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkad\.php|https:\/\/(?:api\.weibo\.cn|mapi\.weibo\.com)\/2\/profile\/(?:container_timeline|statuses\/tab)(?:\?|$)|https:\/\/(?:api\.weibo\.cn|mapi\.weibo\.com)\/2\/(?:profile\/dealatt|friendships\/(?:create|destroy))(?:\?|$)|https:\/\/(?:api\.weibo\.cn|mapi\.weibo\.com)\/2\/profile\/userinfo(?:\?|$)|https:\/\/api\.weibo\.cn\/2\/statuses\/(?:container_timeline|unread_hot_timeline)|https:\/\/(?:api\.weibo\.cn|mapi\.weibo\.com)\/2\/(?:cardlist|page|container\/asyn|flowlist|groups\/timeline|statuses\/(?:friends\/timeline|unread_friends_timeline|repost_timeline))(?:\?|$)|https:\/\/(?:api\.weibo\.cn|mapi\.weibo\.com)\/2\/flowpage(?:\?|$)|https:\/\/api\.weibo\.cn\/2\/shproxy\/chaohua\/discovery\/searchactive(?:\?|$)|https:\/\/(?:api\.weibo\.cn|mapi\.weibo\.com)\/2\/(?:video\/(?:full_screen_stream|tiny_stream_video_list|community_tab)|statuses\/video_mixtimeline)(?:\?|$)|https:\/\/api\.weibo\.cn\/2\/video\/tiny_stream_mid_detail(?:\?|$)|https:\/\/api\.weibo\.cn\/2\/video\/flow_stream_cache(?:\?|$)|https:\/\/api\.weibo\.cn\/2\/search\/finder\?|https:\/\/(?:api\.weibo\.cn|mapi\.weibo\.com)\/2\/(?:search\/(?:container_timeline|container_discover)|searchall)(?:\?|$)|https:\/\/api\.weibo\.cn\/2\/statuses\/container_detail\?|https:\/\/(?:api\.weibo\.cn|mapi\.weibo\.com)\/2\/statuses\/(?:extend|show)(?:\?|$)|https:\/\/api\.weibo\.cn\/2\/statuses\/container_detail_comment|https:\/\/(?:api\.weibo\.cn|mapi\.weibo\.com)\/2\/comments\/build_comments(?:\?|$)|https:\/\/api\.weibo\.cn\/2\/statuses\/container_positive|https:\/\/api\.weibo\.cn\/2\/messageflow\/notice|https:\/\/api\.weibo\.cn\/2\/push\/active|https:\/\/api\.weibo\.cn\/2\/checkin\/show), requires-body=1, max-size=2097152, timeout=10, script-path=https://raw.githubusercontent.com/leetingo/surge-rules/main/scripts/weibo.js?v=5.3.0, argument="module=ad&splash={{{splash}}}&feed_ad={{{feed_ad}}}&video_ad={{{video_ad}}}&video_autoplay={{{video_autoplay}}}&profile_ad={{{profile_ad}}}&profile_follow_rec={{{profile_follow_rec}}}&follow_rec={{{follow_rec}}}&notify_nag={{{notify_nag}}}&discover_banner={{{discover_banner}}}&hot_search_ad={{{hot_search_ad}}}&chaohua_ad={{{chaohua_ad}}}&detail_ad={{{detail_ad}}}&detail_hot_search={{{detail_hot_search}}}&detail_reward={{{detail_reward}}}&detail_share_tip={{{detail_share_tip}}}&detail_positive={{{detail_positive}}}&comment_ad={{{comment_ad}}}&comment_tip={{{comment_tip}}}&comment_ai={{{comment_ai}}}&message_ad={{{message_ad}}}&message_rec={{{message_rec}}}&popup_float={{{popup_float}}}&redpacket={{{redpacket}}}&launch_guide={{{launch_guide}}}&checkin={{{checkin}}}&push_daily={{{push_daily}}}&hot_spotlight={{{hot_spotlight}}}&biz_domain={{{biz_domain}}}&huodong_domain={{{huodong_domain}}}&entry={{{entry}}}"
# 直接返回空结果的请求：开屏广告的实时请求、通知开关引导的配置、热门微博聚光
weibo.ad.block = type=http-request, pattern=^(?:https:\/\/bootrealtime\.uve\.weibo\.com\/v[23]\/ad\/realtime|https:\/\/api\.weibo\.cn\/2\/push\/daily|https:\/\/api\.weibo\.cn\/2\/hot\/hours_spotlight\?), script-path=https://raw.githubusercontent.com/leetingo/surge-rules/main/scripts/weibo.js?v=5.3.0, argument="module=ad&splash={{{splash}}}&feed_ad={{{feed_ad}}}&video_ad={{{video_ad}}}&video_autoplay={{{video_autoplay}}}&profile_ad={{{profile_ad}}}&profile_follow_rec={{{profile_follow_rec}}}&follow_rec={{{follow_rec}}}&notify_nag={{{notify_nag}}}&discover_banner={{{discover_banner}}}&hot_search_ad={{{hot_search_ad}}}&chaohua_ad={{{chaohua_ad}}}&detail_ad={{{detail_ad}}}&detail_hot_search={{{detail_hot_search}}}&detail_reward={{{detail_reward}}}&detail_share_tip={{{detail_share_tip}}}&detail_positive={{{detail_positive}}}&comment_ad={{{comment_ad}}}&comment_tip={{{comment_tip}}}&comment_ai={{{comment_ai}}}&message_ad={{{message_ad}}}&message_rec={{{message_rec}}}&popup_float={{{popup_float}}}&redpacket={{{redpacket}}}&launch_guide={{{launch_guide}}}&checkin={{{checkin}}}&push_daily={{{push_daily}}}&hot_spotlight={{{hot_spotlight}}}&biz_domain={{{biz_domain}}}&huodong_domain={{{huodong_domain}}}&entry={{{entry}}}"
# 微博里的管理页面，以及它读写设置用的接口
weibo.ad.settings = type=http-request, pattern=^https:\/\/api\.weibo\.cn\/surge-rules\/weibo\/(?:settings|api\/ad)(?:\?|$), requires-body=1, max-size=65536, script-path=https://raw.githubusercontent.com/leetingo/surge-rules/main/scripts/weibo.js?v=5.3.0, argument="module=ad&splash={{{splash}}}&feed_ad={{{feed_ad}}}&video_ad={{{video_ad}}}&video_autoplay={{{video_autoplay}}}&profile_ad={{{profile_ad}}}&profile_follow_rec={{{profile_follow_rec}}}&follow_rec={{{follow_rec}}}&notify_nag={{{notify_nag}}}&discover_banner={{{discover_banner}}}&hot_search_ad={{{hot_search_ad}}}&chaohua_ad={{{chaohua_ad}}}&detail_ad={{{detail_ad}}}&detail_hot_search={{{detail_hot_search}}}&detail_reward={{{detail_reward}}}&detail_share_tip={{{detail_share_tip}}}&detail_positive={{{detail_positive}}}&comment_ad={{{comment_ad}}}&comment_tip={{{comment_tip}}}&comment_ai={{{comment_ai}}}&message_ad={{{message_ad}}}&message_rec={{{message_rec}}}&popup_float={{{popup_float}}}&redpacket={{{redpacket}}}&launch_guide={{{launch_guide}}}&checkin={{{checkin}}}&push_daily={{{push_daily}}}&hot_spotlight={{{hot_spotlight}}}&biz_domain={{{biz_domain}}}&huodong_domain={{{huodong_domain}}}&entry={{{entry}}}"

[MITM]
hostname = %APPEND% api.weibo.cn, mapi.weibo.com, bootpreload.uve.weibo.com, bootrealtime.uve.weibo.com, sdkapp.uve.weibo.com, wbapp.uve.weibo.com
