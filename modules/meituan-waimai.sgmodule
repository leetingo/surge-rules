#!name=美团外卖：去广告（第一步）
#!desc=第一步只做一件事：让美团外卖的接口从私有长连接改走 HTTPS。这样开屏、弹窗和信息流的数据才看得到、改得了。本版还不删任何广告，用来抓包取证。
#!category=美团
#!author=leetingo
#!homepage=https://github.com/leetingo/surge-rules
#!version=0.2.0

[Rule]
# 美团的接口默认走私有长连接（Shark）：按 IP 直连服务器的 443 端口，不是 TLS，Surge 看不到内容。
# 某个请求的长连接被拒后，应用会把这个请求改走 HTTPS；但只要还有别的接入服务器连得上，它就继续用长连接。
# 所以要把美团名下的地址段全部列进去。只匹配按 IP 直连、既不是 TLS 也不是 HTTP 的 TCP。
AND,((RULE-SET,https://raw.githubusercontent.com/leetingo/surge-rules/main/rules/meituan-shark.list,no-resolve), (PROTOCOL,TCP), (NOT,((PROTOCOL,HTTPS))), (NOT,((PROTOCOL,HTTP)))),REJECT

[MITM]
hostname = %APPEND% wmapi.meituan.com
