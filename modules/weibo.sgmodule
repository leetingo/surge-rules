#!name=微博去广告
#!desc=去掉微博的开屏广告、信息流广告、关注流里的推荐微博、详情页广告卡片、评论区广告、发现页轮播窗、消息页的广告和推荐关注、“我”页面的任务卡片、钱包、活动入口和为你推荐、签到弹窗和悬浮窗。只有规则、响应改写和本地映射，不含任何脚本。

[Rule]
# 微博广告平台的域名：广告图片，以及广告的曝光和点击上报
DOMAIN-SUFFIX,biz.weibo.com,REJECT,pre-matching

[Body Rewrite]
# 开屏广告：清空预加载的广告列表
http-response-jq ^https:\/\/bootpreload\.uve\.weibo\.com\/v[12]\/ad\/preload 'if type == "object" and (.ads | type) == "array" then .ads = [] else . end'
# 所有信息流：去掉广告微博、广告卡片和“开启通知”横幅，含分组里嵌套的条目
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/statuses\/container_timeline 'def isad: type == "object" and (.data | type) == "object" and (.data.mblogtypename == "广告" or .data.is_ad == 1 or .data.is_ad == "1" or .data.ad_state == 1 or .data.ad_state == "1" or .data.readtimetype == "adMblog" or .data.is_ad_card == 1 or (.data.card_type == 118 and .data.itemid == "finder_window")); def isnag: type == "object" and .category == "cell" and (.title | type) == "object" and ((.title.content // "") | tostring | test("开启通知")); def clean: if type == "object" and (.items | type) == "array" then .items |= (map(select((isad or isnag) | not)) | map(clean)) else . end; clean'
# 关注流：去掉未关注账号的推荐微博，即带“关注 X 的人也关注”这类标题的条目
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/statuses\/container_timeline(_unread)?\? 'def isrec: type == "object" and .category == "feed" and (.data | type) == "object" and (.data.user | type) == "object" and .data.user.following == false and (.data.title | type) == "object" and ((.data.title.text // "") | tostring | length) > 0; if type == "object" and (.items | type) == "array" then .items |= map(select(isrec | not)) else . end'
# 热门和发现页：信息流广告、顶部轮播窗、带推广标记的热搜
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/search\/finder\? 'def isad: type == "object" and (.data | type) == "object" and (.data.mblogtypename == "广告" or .data.is_ad == 1 or .data.is_ad == "1" or .data.ad_state == 1 or .data.ad_state == "1" or .data.readtimetype == "adMblog" or .data.is_ad_card == 1 or (.data.card_type == 118 and .data.itemid == "finder_window")); def isnag: type == "object" and .category == "cell" and (.title | type) == "object" and ((.title.content // "") | tostring | test("开启通知")); def clean: if type == "object" and (.items | type) == "array" then .items |= (map(select((isad or isnag) | not)) | map(clean)) else . end; def hot17: if type == "object" and (.items | type) == "array" then .items |= map(if type == "object" and (.data | type) == "object" and .data.card_type == 17 and (.data.group | type) == "array" then .data.group |= map(select((type == "object" and has("promotion")) | not)) else . end | hot17) else . end; if type == "object" then (if (.channelInfo | type) == "object" and (.channelInfo.channels | type) == "array" then .channelInfo.channels |= map(if type == "object" and (.payload | type) == "object" then .payload |= clean else . end) else . end) | (if (.header | type) == "object" and (.header.data | type) == "object" then .header.data |= (clean | hot17) else . end) else . end'
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/search\/container_timeline 'def isad: type == "object" and (.data | type) == "object" and (.data.mblogtypename == "广告" or .data.is_ad == 1 or .data.is_ad == "1" or .data.ad_state == 1 or .data.ad_state == "1" or .data.readtimetype == "adMblog" or .data.is_ad_card == 1 or (.data.card_type == 118 and .data.itemid == "finder_window")); def isnag: type == "object" and .category == "cell" and (.title | type) == "object" and ((.title.content // "") | tostring | test("开启通知")); def clean: if type == "object" and (.items | type) == "array" then .items |= (map(select((isad or isnag) | not)) | map(clean)) else . end; clean'
# 微博详情页：正文下方的广告卡片
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/statuses\/container_detail\? 'def isad: type == "object" and (.data | type) == "object" and (.data.mblogtypename == "广告" or .data.is_ad == 1 or .data.is_ad == "1" or .data.ad_state == 1 or .data.ad_state == "1" or .data.readtimetype == "adMblog" or .data.is_ad_card == 1 or (.data.card_type == 118 and .data.itemid == "finder_window")); def isnag: type == "object" and .category == "cell" and (.title | type) == "object" and ((.title.content // "") | tostring | test("开启通知")); def clean: if type == "object" and (.items | type) == "array" then .items |= (map(select((isad or isnag) | not)) | map(clean)) else . end; if type == "object" and (.pageHeader | type) == "object" and (.pageHeader.data | type) == "object" then .pageHeader.data |= clean else . end'
# 评论区：去掉插在评论之间的广告微博
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/statuses\/container_detail_comment 'if type == "object" and (.items | type) == "array" then .items |= map(select((type == "object" and .type == "trend" and (.data | type) == "object" and (.data | has("adType") or ((.blog | type) == "object" and (.blog.mblogtypename == "广告" or .blog.is_ad == 1 or .blog.ad_state == 1)))) | not)) else . end'
# 详情页里互动后插入的推荐内容
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/statuses\/container_positive 'if type == "object" and (.items | type) == "array" then .items = [] else . end'
# “我”页面：只保留数据栏、快捷入口、超话和更多功能；去掉任务卡片、钱包一栏、活动入口和“为你推荐”
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/profile\/me 'if type == "object" and (.items | type) == "array" then (.items |= (map(select((type == "object" and ((.category == "mine" and (.type == "card5" or .type == "mineAttent")) or .itemId == "mine_attent_title" or .itemId == "100505_-_mypay_new" or (.category == "card" and (.data | type) == "object" and .data.card_type == 236))) | not)) | map(if type == "object" and (.items | type) == "array" then .items |= map(if type == "object" then del(.adData) else . end) else . end))) | (if (.moreInfo | type) == "object" then .moreInfo.noMore = true else . end) else . end'
# 消息页动态：去掉广告卡片和“推荐关注”，保留你关注的人的动态提醒
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/messageflow\/notice 'if type == "object" and (.messages | type) == "array" then .messages |= map(select((type == "object" and (.isrecommend == true or ((.msg_card | type) == "object" and (.msg_card | (has("ad_tag") or has("ad_click_actionlog")))))) | not)) else . end'
# 私信列表：去掉“群推荐”入口
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/direct_messages\/user_list 'if type == "object" and (.user_list | type) == "array" then .user_list |= map(select((type == "object" and (.user | type) == "object" and (.user.id == 101 or .user.screen_name == "群推荐")) | not)) else . end'
# 关注页顶部直播条：去掉推荐来的直播，保留关注的人的直播
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/live\/media_homelist 'if type == "object" and (.data | type) == "array" then .data |= map(select((type == "object" and .from_tuijian == true) | not)) else . end'
# 签到弹窗
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/checkin\/show 'if type == "object" and has("show") then .show = 0 else . end'
# 悬浮窗和信息流里的红包图标
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/push\/active 'if type == "object" then (if (.floating_windows | type) == "array" then .floating_windows = [] else . end) | (if has("disable_floating_window") then .disable_floating_window = "1" else . end) | (if (.feed_redpacket | type) == "object" then .feed_redpacket.starttime = "2208960000" | .feed_redpacket.endtime = "2209046399" | .feed_redpacket.interval = "31536000" else . end) else . end'

[Map Local]
# 开屏广告的实时请求：直接返回空结果
^https:\/\/bootrealtime\.uve\.weibo\.com\/v[23]\/ad\/realtime data-type=text data="{}" header="Content-Type: application/json"

[MITM]
hostname = %APPEND% api.weibo.cn, bootpreload.uve.weibo.com, bootrealtime.uve.weibo.com
